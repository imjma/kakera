#!/bin/sh
script="$(dirname "$(realpath "$0")")/kakera.py"
case "${1:-}" in
  local) shift; exec uv run "$script" --local "$@" ;;
  inbox) shift; exec uv run "$script" --inbox "$@" ;;
  todoist) shift; exec uv run "$script" --todoist "$@" ;;
  telegram) shift; exec uv run "$script" --telegram-note "$@" ;;
  telegram-only) shift; exec uv run "$script" --telegram-note-only "$@" ;;
  --telegram-only) exec uv run "$script" "$@" ;;
  instagram-cookies) shift; exec uv run "$script" --instagram-cookies "$@" ;;
  twitter-cookies) shift; exec uv run "$script" --twitter-cookies "$@" ;;
  reddit-oauth) shift; exec uv run "$script" --reddit-oauth "$@" ;;
  *) exec uv run "$script" --obsidian "$@" ;;
esac
